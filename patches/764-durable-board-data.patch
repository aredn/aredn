 #!/bin/sh
 
-REAL_CFG=$1
+REAL_CFG=${1:-/etc/board.json}
+WRITER=/usr/local/bin/aredn-board-write
 
-[ -n "$REAL_CFG" ] || REAL_CFG=/etc/board.json
+"$WRITER" check "$REAL_CFG" && exit 0
+[ -d /etc/board.d ] || exit 1
 
-if [ -d "/etc/board.d/" ] && [ ! -s "$REAL_CFG" ]; then
-	# Use temp file to prevent incomplete file on power-cut, CFG is used by the sourced script to read/write the file
-	CFG="$(dirname "$REAL_CFG")/.$(basename "$REAL_CFG").tmp"
-	rm -f "$CFG" || exit
-	for a in $(ls /etc/board.d/*); do
-		[ -s "$a" ] || continue
-		(. "$a")
-	done
-fi
+# Unique same-filesystem staging; no incomplete file is ever the live board.
+STAGE=$(mktemp -d "$(dirname "$REAL_CFG")/.board-detect-XXXXXX") || exit 1
+CFG="$STAGE/board.json"
+cleanup() {
+	rm -f "$CFG" "$CFG.lock"
+	rmdir "$STAGE"
+}
+trap cleanup EXIT
+trap 'exit 1' HUP INT TERM
+for a in /etc/board.d/*; do
+	[ -s "$a" ] || continue
+	(. "$a") || exit 1
+done
 
-if [ -s "$CFG" ]; then
-	mv "$CFG" "$REAL_CFG" || exit
-else
-	rm -f "$CFG"
-	exit 1
-fi
+# Lock and recheck the destination so a concurrent repair is not overwritten.
+"$WRITER" install-if-invalid "$REAL_CFG" "$CFG"
