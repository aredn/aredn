{%
/* Time popup details by mathisono (2026), GPL-3.0-or-later.
 * Read-only native evidence, separate from the staged time settings. */
const gps = uci.get("aredn", "@time[0]", "gps_enable") === "1" ? require("aredn.gpslock").current() : null;
const status = require("aredn.timestatus").current(gps);
const items = [
    { label: "status", value: status.label },
    { label: "source", value: status.sourceDisplay || status.source },
    { label: status.report?.label || "last synchronization", value: status.report?.time || "Time not recorded" }
];
if (status.report) {
    push(items, { label: "observation age", value: status.report.age });
    push(items, { label: "NTP update mode", value: status.report.mode });
    if (status.report.stratum !== null) push(items, { label: "NTP stratum", value: "" + status.report.stratum });
}
if (gps && (status.sync === "gps" || status.sync === "network gps" || !status.sync ||
    gps.source?.kind === "local" || gps.source?.kind === "network")) {
    push(items, { label: "GPS connection", value: gps.source?.kind === "local" ? "Local" :
        gps.source?.kind === "network" ? "Network" : "Unknown" });
    push(items, { label: "GPS receiver", value: gps.source?.endpoint || "Not recorded" });
    push(items, { label: "GPS receiver status", value: gps.reason });
}
function escape(value) {
    return replace(replace(replace(replace(replace(value, /&/g, "&amp;"), /</g, "&lt;"), />/g, "&gt;"), /"/g, "&quot;"), /'/g, "&#39;");
}
%}
<div class="cols">
    {% for (let item in items) { %}
    <div class="i">
        <div>{{escape(item.value)}}</div>
        <div>{{item.label}}</div>
    </div>
    {% } %}
</div>
<div class="m">{{escape(status.detail)}}</div>
