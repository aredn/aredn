%}
{%
    const d = split(fs.readfile("/proc/uptime"), " ");
    const up = int(d[0]);
    let uptime = sprintf("%d:%02d", int(up / 3600) % 24, int(up / 60) % 60);
    if (up >= 172800) {
        uptime = int(up / 86400) + " days, " + uptime;
    }
    else if (up > 86400) {
        uptime = "1 day, " + uptime;
    }
    const ld = split(fs.readfile("/proc/loadavg"), " ");
    const meminfo = fs.readfile("/proc/meminfo");
    const ram = int(match(meminfo, /MemAvailable: +(\d+) kB/)[1]) / 1000.0;
    const totram = int(match(meminfo, /MemTotal: +(\d+) kB/)[1]) / 1000;
    const f = fs.popen("exec /bin/df /");
    let flash = "-";
    if (f) {
        flash = int(split(f.read("all"), /\s+/)[10]) / 1000.0;
        f.close();
    }
    const tm = localtime();
    let tz = "time";
    const tf = fs.popen("exec /bin/date +%Z");
    if (tf) {
        tz = `${uc(trim(tf.read("all")))}`;
        tf.close();
    }
    // GPS lock badge support added by mathisono (2026). Never infer lock from
    // /tmp/timesync: that marker only describes the last clock-sync source.
    const gpslock = uci.get("aredn", "@time[0]", "gps_enable") === "1" ? require("aredn.gpslock").current() : null;
    const gpssource = gpslock?.source;
    const gpsstate = gpslock?.state === "unknown" ? "UNKNOWN" : gpslock?.state === "locked" ? "LOCK" :
        gpslock?.state === "pending" ? "WAIT" : "ERROR";
    const gpsclass = gpslock?.state === "unknown" ? "pending" : gpslock?.state;
    const gpsdetail = gpslock ? gpslock.reason + (gpssource?.endpoint ?
        (gpssource.kind === "local" ? "; Receiver attached to this node: " : "; Receiver supplied over the network by GPSD server: ") + gpssource.endpoint :
        "; GPS source has not been identified") : "";
    function gpsEscape(value) {
        return replace(replace(replace(replace(replace(value, /&/g, "&amp;"), /</g, "&lt;"), />/g, "&gt;"), /"/g, "&quot;"), /'/g, "&#39;");
    }
    const timeStatus = require("aredn.timestatus").current(gpslock);
    // The full popup explanation repeats this summary; do not append it here.
    const timeHover = "Source: " + (timeStatus.sourceDisplay || timeStatus.source) + "; " + timeStatus.note;
%}
<div class="ctrl" hx-get="status/e/time" hx-target="#ctrl-modal">
    {% if (uci.get("aredn", "@time[0]", "military") === "1") { %}
    <div class="t">{{sprintf("%02d:%02d", tm.hour, tm.min)}}</div>
    {% } else { %}
    <div class="t">{{tm.hour === 0 ? "12" : tm.hour > 12 ? tm.hour - 12 : tm.hour}}:{{sprintf("%02d", tm.min)}} {{tm.hour >= 12 ? "pm" : "am"}}</div>
    {% } %}
    <div class="s"><span class="t time-zone">{{tz}}</span><span class="time-sync-status {{timeStatus.state}}" role="status" aria-label="{{gpsEscape(timeHover)}}" title="{{gpsEscape(timeHover)}}">{{timeStatus.label}}</span></div>
    {% if (gpslock && (gpssource?.kind === "local" || gpssource?.kind === "network") && timeStatus.sync === "ntp") { %}
    <div class="s"><span class="gps-lock-status {{gpsclass}}" role="status" aria-label="{{gpsEscape(gpsdetail)}}" title="{{gpsEscape(gpsdetail)}}">GPS {{gpsstate}}</span></div>
    {% } %}
</div>
<div class="noctrl">
    <div class="t">{{uptime}}</div>
    <div class="s">uptime</div>
    <div class="t">{{ld[0]}}&nbsp;&nbsp;{{ld[1]}}&nbsp;&nbsp;{{ld[2]}}</div>
    <div class="s">load average</div>
    <div class="cols">
        <div>
            <div class="t">{{flash}} MB</div>
            <div class="s">free flash</div>
        </div>
        <div>
            <div class="t">{{ram}} MB</div>
            <div class="s">available ram</div>
        </div>
        <div>
            <div class="t">{{totram}} MB</div>
            <div class="s">total ram</div>
        </div>
    </div>
</div>
