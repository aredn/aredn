export function getTimezoneList()
{
    return TIMEZONES;
};

export function lookupTimezone(name)
{
    if (!name) {
        name = configuration.getSettingAsString("time_zone_name", "UTC");
    }
    return TIMEZONES[name] || { code: "HX", tz: "UTC" };
};
