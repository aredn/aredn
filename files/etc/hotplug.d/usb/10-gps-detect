#!/bin/sh

. /lib/functions.sh

GPSDETECTED="/tmp/gps-detected"

if [ "${ACTION}" = "add" ]; then
    case "${PRODUCT}" in
        1546/1a7/*) # VK-162 & VK-172
            touch ${GPSDETECTED}
            ;;
        *)
            ;;
    esac
elif [ "${ACTION}" = "remove" ]; then
    case "${PRODUCT}" in
        1546/1a7/*) # VK-162 & VK-172
            rm -f ${GPSDETECTED}
            ;;
        *)
            ;;
    esac
fi
